  "keyFeatures": [
    "Deterministic proxy deployment using CREATE2",
    "EIP-712 signed hooks with nonce management",
    "Support for both EOA and smart contract wallets (EIP-1271)",
    "Pre-signing functionality for on-chain authorization",
    "Gas-efficient bitmap-based nonce tracking",
    "Multi-chain deployment with consistent addresses"
